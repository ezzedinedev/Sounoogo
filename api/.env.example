APP_NAME=SUNOOGO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite pour démarrer vite ; PostgreSQL (docker compose) en équipe et en production.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=sunoogo
# DB_USERNAME=sunoogo
# DB_PASSWORD=sunoogo

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Temps réel (Laravel Reverb) ---
REVERB_APP_ID=sunoogo
REVERB_APP_KEY=sunoogo-key
REVERB_APP_SECRET=sunoogo-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- SUNOOGO ---
SUNOOGO_COUNTRY=BF

# Paiements : mock (hors production) | wave | orange_money
PAYMENT_SUCCESS_URL="${APP_URL}/paiement/succes"
PAYMENT_ERROR_URL="${APP_URL}/paiement/echec"

MONEYFUSION_API_URL=

# IA (Claude, Anthropic) : second regard sur le risque et copilote des écoutants.
# Désactivée par défaut ; l'activer confie le texte des conversations (sans pseudonyme) à Anthropic.
SUNOOGO_AI_ENABLED=false
ANTHROPIC_API_KEY=

# Notifications push (Firebase Cloud Messaging) : chemin du JSON du compte de service, ou son contenu en base64.
FIREBASE_CREDENTIALS=

# Téléconsultation : serveur Jitsi Meet auto-hébergé (vide = visio désactivée).
# JITSI_APP_ID / JITSI_APP_SECRET : authentification JWT de Jitsi (recommandée en production).
JITSI_URL=
JITSI_APP_ID=
JITSI_APP_SECRET=

# Rémunération des professionnels : commission de la plateforme (%) et versement minimum (F CFA).
SUNOOGO_COMMISSION_PERCENT=0
SUNOOGO_PAYOUT_MINIMUM=5000

# Suivi des erreurs (Sentry). Aucune donnée personnelle ni corps de requête n'est transmis.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Sauvegardes quotidiennes (spatie/laravel-backup) : disques de destination, mot de passe de l'archive, alertes.
BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=
